# Copy this file to .env.staging and fill in your Namecheap sandbox account details.
# Run `chmod 600 .env.staging` before passing it to the CLI or smoke scripts.
# The CLI never loads .env or .env.staging automatically.
# NAMECHEAP_USERNAME is normally the same value as NAMECHEAP_API_USER.
# NAMECHEAP_CLIENT_IP must be a public IPv4 address whitelisted in the sandbox.
NAMECHEAP_API_USER=
NAMECHEAP_API_KEY=
NAMECHEAP_USERNAME=
NAMECHEAP_CLIENT_IP=
NAMECHEAP_ENVIRONMENT=sandbox
